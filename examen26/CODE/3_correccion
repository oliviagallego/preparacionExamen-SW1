B) POST /admin/products/:id/delete
  Borra producto por id
  Pone req.session.message = "Producto eliminado"
  Redirige a /admin/products

En admin.js:

router.post("/products/:id/delete", (req, res, next) =>{
  const id= Number(req.params.id);

  const existed = !!database.products.data[id];
  if (existed) {
    delete database.products.data[id];
    req.session.message = "Producto eliminado";
  } else {
    req.session.error = "No existe ese producto";
  }

  return res.redirect("/admin/products");
});



























