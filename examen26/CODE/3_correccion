3) Admin products: tabla + buscador + borrar

En routes/admin.js añade:

A) GET /admin/products
  Soporta buscador: /admin/products?q=go
  Filtra por nombre
  Renderiza admin_products.ejs con { products, q }

router.get("/products", (req, res) =>{
  const q= String(req.query.q || " ").trim().toLowerCase;
  const all= Object.values(database.users.data);
  const finder= q ? all.filter(p => String(p.name).toLowerCase.include(q)) : all;
  return res.render("admin_products", {title: "Productos", q, finder: productos})
}

