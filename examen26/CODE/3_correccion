2) RUTA restringida: carrito
Crea routes/cart.js con: GET /cart → renderiza cart.ejs, Solo entra si hay req.session.user (checkLogin).
Muestra lo que hay en req.session.cart (si no existe, array vacío).

--> En app.js

const express= require("express");
const router= express.Router();
const database= require("../database");

const cartRouter = require("./routes/cart");

function checkLogin(req, res, next){
  if(!req.session.user){
    req.session.error="Error al login",
    return res.redirect("/login");
  }
  return next();
}

app.use("/cart", checkLogin, cartRouter);

--> En routes/cart.js:

const express= require("express");
const router= express.Router();
const database= require("../database");

router.get("/", (req, res, next) => {
  const cart= req.session.cart || [];
  return res.render("/", {title: "Cart", cart});
}

module.exports= router;

--> En views/cat.ejs

<%- include("header", <%title%>) %>

<% if(!cart || cart.lenght === 0) { %>
  <p> Carrito </p>
<% }else{ %>
    <ul>
      <% cart.forEach( c => { %>
        <li> <%= c.name %> - <%= c.price %> </li>
      <% }) %>
    </ul>
<% -include("footer") %>

